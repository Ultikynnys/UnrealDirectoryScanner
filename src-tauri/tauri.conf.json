{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UnrealDirectoryScanner",
  "version": "0.6.0",
  "identifier": "com.ultikynnys.unrealdirectoryscanner",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Unreal Directory Scanner",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
