# Dependencies
node_modules/

# Tauri / Cargo build output
src-tauri/target/

# tsc output, generated into the web assets dir that Tauri embeds. The whole directory
# is hand-written markup plus compiled JavaScript, so ignore every .js rather than naming
# each one tsc happens to emit.
/web/*.js

# Generated by tauri-build (capability schemas)
src-tauri/gen/

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# scratch left behind by the coding agent and the tools it drives, never project files
.reasonix/
.playwright-mcp/
